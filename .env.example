APP_ENV=dev
TZ=UTC

DATASET_PATH=data/raw/bank-additional-full.csv
REFERENCE_DATA_PATH=data/processed/reference.csv
MODEL_PATH=models/model.pkl
MODEL_METADATA_PATH=models/model_metadata.json
LOG_DIR=logs
REPORT_DIR=reports

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=bank_marketing_xgboost

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlops
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
DATABASE_URL=postgresql+psycopg2://mlops:mlops@postgres:5432/mlops

DRIFT_THRESHOLD=0.30
RETRAIN_IMPROVEMENT_THRESHOLD=0.005
DEGRADATION_THRESHOLD=0.03

API_HOST=0.0.0.0
API_PORT=8000
